# Token pessoal do GitHub com permissões somente de leitura para o repositório.
# Nunca coloque o token real neste arquivo, no app Android ou no Git.
GITHUB_TOKEN=
GITHUB_OWNER=iikawalucas-13
GITHUB_REPO=SwitchFileHub-

# Identidade Google que receberá o papel ADMIN no backend.
# Configure somente no ambiente privado de hospedagem; não use este arquivo para guardar o valor real.
ADMIN_GOOGLE_EMAIL=
# Client ID OAuth do aplicativo Google, usado para validar tokens no backend.
GOOGLE_OAUTH_CLIENT_ID=
